# Required for Gemini-powered features
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Current Gemini model. You can change this to another model available to your account.
GEMINI_MODEL=gemini-3.8-flash

# Optional local concept explanation model.
# Leave false for the simplest installation.
LOCAL_EXPLANATION_ENABLED=false
LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M

APP_NAME=EduGenie
ENVIRONMENT=development
MAX_INPUT_CHARS=12000
REQUEST_TIMEOUT_SECONDS=90
